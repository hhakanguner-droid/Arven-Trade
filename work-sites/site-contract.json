{
  "phase": 14,
  "product": "ARVEN Trade",
  "repository": "hhakanguner-droid/Arven-Trade",
  "production_branch": "main",
  "backend_contract_phase": 13,
  "backend_baseline_commit": "44a72f6f64dcb249e7ff0c36ae5f51031e8dd881",
  "market_scope": "BIST/Turkiye",
  "existing_site_url": "https://arven-trade.hhakanguner.chatgpt.site/",
  "visual_sources": [
    "ARVEN_TRADE_PC_Mobil_PWA_Mockuplari.pdf",
    "ARVEN_TRADE_PC_Ana_Pano.png",
    "ARVEN_TRADE_PC_Hisse_Analizi.png",
    "ARVEN_TRADE_Mobil_PWA_Mockuplari.png",
    "ARVEN_TRADE_Splash_Mockup.png",
    "ARVEN_TRADE_Logo.png"
  ],
  "deployment": {
    "mode": "sites_hosted_fullstack",
    "update_existing_site": true,
    "create_replacement_site": false,
    "separate_backend_deployment_required": false,
    "external_phase13_https_url_required": false,
    "tradingagents_api_token_required_for_sites_local_calls": false,
    "phase13_api_is_behavioral_contract": true,
    "sites_server_routes_required": true,
    "python_runtime_may_require_sites_adapter": true,
    "adapter_language_preference": "typescript",
    "must_not_fake_unsupported_runtime_behavior": true,
    "durable_storage": "D1",
    "object_storage": "R2_when_needed",
    "hosted_secrets_supported": true,
    "hosted_secrets_required_for_provider_credentials": true,
    "ask_user_only_for_genuinely_missing_provider_secret": true,
    "record_saved_version_git_sha": true,
    "deploy_to_existing_url": true
  },
  "security": {
    "browser_bearer_token_allowed": false,
    "same_origin_server_boundary_required": true,
    "sites_local_server_calls_need_internal_bearer_token": false,
    "client_secret_storage_forbidden": [
      "javascript_bundle",
      "service_worker",
      "localStorage",
      "indexedDB",
      "client_visible_env",
      "html"
    ],
    "provider_secrets_location": "Sites hosted secrets"
  },
  "phase13_behavior_contract": {
    "public": [
      {"method": "GET", "path": "/healthz"}
    ],
    "reference_routes": [
      {"method": "GET", "path": "/api/v1/health"},
      {"method": "POST", "path": "/api/v1/analyses", "forward_headers": ["Idempotency-Key"]},
      {"method": "GET", "path": "/api/v1/analyses/{job_id}"},
      {"method": "GET", "path": "/api/v1/history"},
      {"method": "GET", "path": "/api/v1/history/{analysis_id}"},
      {"method": "GET", "path": "/api/v1/compare/{ticker}"},
      {"method": "GET", "path": "/api/v1/performance"},
      {"method": "GET", "path": "/api/v1/market"},
      {"method": "GET", "path": "/api/v1/price-history/{ticker}"}
    ]
  },
  "browser_routes": [
    {"method": "GET", "path": "/api/arven/health", "implementation": "sites_server_route", "behavior_reference": "/api/v1/health"},
    {"method": "POST", "path": "/api/arven/analyses", "implementation": "sites_server_route", "behavior_reference": "/api/v1/analyses"},
    {"method": "GET", "path": "/api/arven/analyses/{job_id}", "implementation": "sites_server_route", "behavior_reference": "/api/v1/analyses/{job_id}"},
    {"method": "GET", "path": "/api/arven/history", "implementation": "sites_server_route", "behavior_reference": "/api/v1/history"},
    {"method": "GET", "path": "/api/arven/history/{analysis_id}", "implementation": "sites_server_route", "behavior_reference": "/api/v1/history/{analysis_id}"},
    {"method": "GET", "path": "/api/arven/compare/{ticker}", "implementation": "sites_server_route", "behavior_reference": "/api/v1/compare/{ticker}"},
    {"method": "GET", "path": "/api/arven/performance", "implementation": "sites_server_route", "behavior_reference": "/api/v1/performance"},
    {"method": "GET", "path": "/api/arven/market", "implementation": "sites_server_route", "behavior_reference": "/api/v1/market"},
    {"method": "GET", "path": "/api/arven/price-history/{ticker}", "implementation": "sites_server_route", "behavior_reference": "/api/v1/price-history/{ticker}"}
  ],
  "analysis_states": ["queued", "running", "succeeded", "failed"],
  "required_error_states": [401, 403, 404, 409, 429, 503, 500],
  "agent_cards": [
    "market",
    "sentiment",
    "news",
    "kap",
    "fundamentals",
    "trader",
    "bull",
    "bear",
    "risk"
  ],
  "agent_identity_lock": {
    "locked": true,
    "language": "tr",
    "replace_initial_letters_with_icons": true,
    "allow_visible_english_agent_titles": false,
    "agents": [
      {"key": "market", "name": "Piyasa Analisti", "icon": "rising_chart"},
      {"key": "sentiment", "name": "Duyarlılık Analisti", "icon": "smiley_face"},
      {"key": "news", "name": "Haber Analisti", "icon": "newspaper"},
      {"key": "fundamentals", "name": "Temel Analist", "icon": "pie_chart"},
      {"key": "kap", "name": "KAP Araştırmacısı", "icon": "kap_document_megaphone"},
      {"key": "bull", "name": "Boğa Görüş Araştırmacısı", "icon": "bull_head"},
      {"key": "bear", "name": "Ayı Görüş Araştırmacısı", "icon": "bear_head"},
      {"key": "risk", "name": "Risk Yöneticisi", "icon": "shield_check"},
      {"key": "trader", "name": "İşlem (Trader) Ajanı", "icon": "target_arrow"}
    ],
    "icon_style": {
      "container": "rounded_light_blue_square",
      "default_tone": "arven_blue",
      "bull_tone": "green",
      "bear_tone": "red",
      "risk_tone": "blue",
      "trader_tone": "blue_violet",
      "consistent_vector_pictograms": true
    }
  },
  "kap_feed": {
    "menu_label": "KAP Açıklamaları",
    "required": true,
    "analysis_card_required": true,
    "chronological_menu_required": true,
    "group_by_day": true,
    "newest_first": true,
    "current_real_scope": ["watchlist_tickers", "analyzed_tickers"],
    "required_fields": [
      "published_at",
      "ticker",
      "company",
      "title_or_subject",
      "summary",
      "official_url"
    ],
    "optional_fields_when_available": [
      "category",
      "severity",
      "score",
      "is_corrective",
      "has_attachment"
    ],
    "filters": ["date", "ticker", "category", "severity"],
    "browser_route_target": "/api/arven/kap/disclosures",
    "browser_route_requires_real_server_implementation": true,
    "external_upstream_required": false,
    "market_wide_all_bist_requires_real_feed": true,
    "must_not_fake_market_wide_feed": true,
    "must_not_show_demo_disclosures": true
  },
  "markets": {
    "menu_label": "Piyasalar",
    "required": true,
    "instrument_groups": ["fx", "parity", "index", "commodity", "crypto"],
    "instruments": {
      "fx": ["USDTRY", "EURTRY", "GBPTRY", "CHFTRY"],
      "parity": ["EURUSD", "GBPUSD", "USDJPY"],
      "index": ["XU100", "XU030", "XBANK", "XUSIN"],
      "commodity": ["XAUUSD", "GRAMALTIN", "XAGUSD", "BRENT"],
      "crypto": ["BTCUSDT", "ETHUSDT"]
    },
    "gramaltin_is_derived": true,
    "gramaltin_derivation": "XAUUSD (ons, USD) * USDTRY / 31.1034768",
    "ticker_tape_required": true,
    "price_history_chart": {
      "required": true,
      "user_selects_ticker": true,
      "quick_select_from_watchlist": true,
      "chart_type": "line",
      "ranges": ["1G", "1H", "1A", "6A", "1Y", "5Y"],
      "stats_required": [
        "last_price",
        "daily_change_pct",
        "period_change_pct",
        "fifty_two_week_high_low"
      ]
    },
    "browser_route_target": "/api/arven/market",
    "price_history_browser_route_target": "/api/arven/price-history/{ticker}",
    "per_instrument_fail_open": true,
    "must_not_fake_prices": true,
    "must_not_show_demo_quotes_in_production": true
  },
  "release": {
    "record_synced_git_sha": true,
    "automatic_git_to_sites_sync_assumed": false
  }
}
